<?xml version="1.0"?>
<hivemq>
    <listeners>
        <tcp-listener>
            <port>1883</port>
            <bind-address>0.0.0.0</bind-address>
        </tcp-listener>
        <tls-tcp-listener>
            <port>8883</port>
            <bind-address>0.0.0.0</bind-address>
            <tls>
                <keystore>
                    <path>/opt/hivemq/conf/certs/server.p12</path>
                    <password>changeit</password>
                    <private-key-password>changeit</private-key-password>
                </keystore>
            </tls>
        </tls-tcp-listener>
        <websocket-listener>
            <port>8083</port>
            <bind-address>0.0.0.0</bind-address>
            <path>/mqtt</path>
            <subprotocols>
                <subprotocol>mqtt</subprotocol>
            </subprotocols>
        </websocket-listener>
        <tls-websocket-listener>
            <port>8084</port>
            <bind-address>0.0.0.0</bind-address>
            <path>/mqtt</path>
            <subprotocols>
                <subprotocol>mqtt</subprotocol>
            </subprotocols>
            <tls>
                <keystore>
                    <path>/opt/hivemq/conf/certs/server.p12</path>
                    <password>changeit</password>
                    <private-key-password>changeit</private-key-password>
                </keystore>
            </tls>
        </tls-websocket-listener>
    </listeners>
    <mqtt>
        <queued-messages>
            <max-queue-size>10000</max-queue-size>
            <strategy>discard</strategy>
        </queued-messages>
        <receive-maximum>
            <server-receive-maximum>65535</server-receive-maximum>
        </receive-maximum>
    </mqtt>
</hivemq>