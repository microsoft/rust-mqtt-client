# Build artifacts and the resolved lockfile for this detached bench crate are
# regenerated locally.
target/
Cargo.lock

# Locally generated TLS test certs (see gen-test-certs.sh) — never committed.
certs/

# Accumulated benchmark results from bench-workload.sh — local run data, not committed.
results.jsonl
*.jsonl

# Python bytecode cache (created when report.py/record.py are imported, e.g. by analysis scripts).
__pycache__/
*.pyc
